# Server
PORT=5000
HOST=0.0.0.0

# Comma separated list of allowed frontend origins, or * for any
CORS_ORIGIN=*

# Storage (paths are relative to the backend/ folder)
UPLOAD_DIR=uploads
DATA_DIR=data
MAX_UPLOAD_MB=20

# Groq chat assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Shown in assistant replies
WHATSAPP_NUMBER=+254 798 872 998

# Public URL of this backend, used for upload links inside emails
PUBLIC_URL=

# Email delivery (Nodemailer). For Gmail use an App Password, not your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wondrouspublishing@gmail.com
SMTP_PASS=
MAIL_TO=wondrouspublishing@gmail.com
MAIL_FROM=Wondrous Publishing Website <wondrouspublishing@gmail.com>

