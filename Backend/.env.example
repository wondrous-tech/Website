# Server
PORT=5000
HOST=0.0.0.0

# Comma separated list of allowed frontend origins, or * for any
CORS_ORIGIN=*

# Storage (paths are relative to the backend/ folder)
UPLOAD_DIR=uploads
DATA_DIR=data
MAX_UPLOAD_MB=20

# Groq chat assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Shown in assistant replies
WHATSAPP_NUMBER=+254 798 872 998

# Public URL of this backend, used for upload links inside emails
PUBLIC_URL=

# Email delivery (Nodemailer via Brevo SMTP relay).
# SMTP_PASS is the Brevo SMTP key (xsmtpsib-...), set it in Railway, not here.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b48073001@smtp-brevo.com
SMTP_PASS=
MAIL_TO=wondrouspublishing@gmail.com
MAIL_FROM=Wondrous Publishing Website <wondrouspublishing@gmail.com>

